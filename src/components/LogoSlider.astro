---
interface Logo {
  name: string;
}

interface Props {
  logos: Logo[];
  repeat?: number;
  delay?: number;
}

const { logos, repeat = 2, delay = 0.5 } = Astro.props;

const group = Array.from({ length: logos.length * repeat }, (_, i) => logos[i % logos.length]);
const set = [...group, ...group];
---
<section
  class="mt-[4.5vw] overflow-hidden max-lg:mt-[9vw]"
  data-reveal-lines="once"
  data-stagger="0.05"
  data-delay={delay.toString()}
  data-trigger="[data-hero]"
  data-start="top bottom"
>
  <div class="marquee-track flex w-max items-center bg-canvas">
    {
      set.map((logo, i) => (
        <div
          class="reveal-line mr-[clamp(2rem,4.2vw,5rem)] flex h-[clamp(3rem,4.8vw,6rem)] shrink-0 items-center max-lg:mr-[5.5vw] max-lg:h-[clamp(1.75rem,9vw,3rem)]"
          aria-hidden={i >= logos.length ? 'true' : undefined}
        >
          <span class="whitespace-nowrap font-display text-[clamp(1.1rem,2.2vw,2.5rem)] font-medium uppercase leading-none tracking-[0.02em] text-graphite max-lg:text-[clamp(0.95rem,4.2vw,1.6rem)]">
            {logo.name}
          </span>
        </div>
      ))
    }
  </div>
</section>
