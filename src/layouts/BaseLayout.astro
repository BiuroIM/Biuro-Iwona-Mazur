---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import ScrollBar from '../components/ScrollBar.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactPill from '../components/ContactPill.astro';
import PageTransition from '../components/PageTransition.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  loadingScreen?: boolean;
}

const {
  title = 'Biuro Rachunkowe Iwona Mazur',
  description = 'Profesjonalna obsługa księgowa, kadrowo-płacowa i doradztwo podatkowe. Biuro Rachunkowe Iwona Mazur.',
  image = '/og-default.jpg',
  loadingScreen = false,
} = Astro.props;

const fullTitle = title === 'Biuro Rachunkowe Iwona Mazur'
  ? title
  : `${title} — Biuro Rachunkowe Iwona Mazur`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="pl" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-satoshi" preload />
    <Font cssVariable="--font-clash" preload />

    <ClientRouter />
  </head>

  <body class="min-h-screen font-sans text-graphite antialiased">
    <div class="page-canvas" aria-hidden="true"></div>

    <ScrollBar />

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <Menu />

    <ContactForm />

    <ContactPill />

    <div
      class="invisible pointer-events-none fixed left-0 top-0 z-[65] flex h-[clamp(5rem,7vw,8.5rem)] w-[clamp(5rem,7vw,8.5rem)] items-center justify-center rounded-full bg-forest opacity-0"
      data-cursor
      aria-hidden="true"
    >
      <span
        class="font-display text-[clamp(0.7rem,0.85vw,1rem)] font-medium uppercase tracking-[0.15em] text-canvas"
        data-cursor-text></span>
    </div>

    <PageTransition />

    {loadingScreen && <LoadingScreen />}

    <script>
      import '../scripts/animations.js';
    </script>
  </body>
</html>
