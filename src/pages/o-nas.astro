---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpecialistsSlider from '../components/SpecialistsSlider.astro';
import { Image } from 'astro:assets';
import officeTeam from '../assets/photos/two-accountants-at-desk.jpg';
import portraitBookkeeping from '../assets/photos/accountant-at-workstation.jpg';
import portraitTaxAdvisory from '../assets/photos/accountant-portrait.jpg';
import portraitPayroll from '../assets/photos/reviewing-documents.jpg';
import portraitLedgers from '../assets/photos/accountant-at-computer.jpg';
import portraitSocialSecurity from '../assets/photos/client-conversation.jpg';
import portraitFlatRate from '../assets/photos/two-accountants-documents.jpg';
import portraitVat from '../assets/photos/open-space-conversation.jpg';
import portraitAnalysis from '../assets/photos/accountant-at-monitor.jpg';
import portraitFrontDesk from '../assets/photos/client-conversation.jpg';

const MARQUEE_REPEATS = 3;
const DASH_LENGTH = 'clamp(3.5rem,9vw,11rem)';
const DASH_THICKNESS = 'clamp(0.3rem,0.8vw,1rem)';

const specialists = [
  {
    name: 'Imię i nazwisko',
    department: 'Księgowość',
    bio: 'Prowadzi księgi handlowe spółek i pilnuje, żeby każdy miesiąc zamykał się na czas. Liczby tłumaczy prostym językiem.',
    photo: portraitBookkeeping,
    photoFocus: 'center 30%',
    photoZoom: 1,
    photoAlt: 'Księgowa przy stanowisku pracy w biurze',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Doradztwo podatkowe',
    bio: 'Układa rozliczenia tak, żeby firma płaciła tyle, ile musi. Reprezentuje klientów w sporach i kontrolach skarbowych.',
    photo: portraitTaxAdvisory,
    photoFocus: 'center top',
    photoZoom: 1,
    photoAlt: 'Doradczyni podatkowa w jasnym garniturze',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Kadry i płace',
    bio: 'Liczy wynagrodzenia, prowadzi akta osobowe i przypomina o terminach, zanim staną się problemem. Zna każdą formę zatrudnienia.',
    photo: portraitPayroll,
    photoFocus: '65% center',
    photoZoom: 1.8,
    photoAlt: 'Specjalistka do spraw kadr nad dokumentami',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Księgowość',
    bio: 'Codziennie księguje dokumenty firm handlowych i usługowych. Wychwytuje błędy w fakturach, zanim trafią do miesięcznej deklaracji.',
    photo: portraitLedgers,
    photoFocus: '60% center',
    photoZoom: 1,
    photoAlt: 'Księgowa przy komputerze w biurze',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Rozliczenia ZUS',
    bio: 'Zgłasza, rozlicza i koryguje składki. Pilnuje zasiłków, zwolnień i wszystkiego, co przechodzi przez Płatnika w imieniu klienta.',
    photo: portraitSocialSecurity,
    photoFocus: 'right 30%',
    photoZoom: 1.4,
    photoAlt: 'Specjalistka do spraw ZUS w rozmowie z klientką',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Księgowość',
    bio: 'Obsługuje jednoosobowe działalności i spółki na ryczałcie. Doradza, którą formę opodatkowania wybrać przed startem nowego roku.',
    photo: portraitFlatRate,
    photoFocus: 'center top',
    photoZoom: 1.5,
    photoAlt: 'Księgowa i koleżanka nad wydrukiem dokumentów',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Podatek VAT',
    bio: 'Rozlicza VAT krajowy i transakcje zagraniczne. Sprawdza stawki, JPK oraz split payment, zanim deklaracja pójdzie dalej.',
    photo: portraitVat,
    photoFocus: '25% 58%',
    photoZoom: 2,
    photoAlt: 'Specjalistka do spraw VAT przy stanowisku pracy',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Analizy finansowe',
    bio: 'Przekłada dane z ksiąg na raporty, które realnie pomagają podejmować decyzje. Pokazuje, gdzie firma traci, a gdzie zarabia.',
    photo: portraitAnalysis,
    photoFocus: '40% center',
    photoZoom: 1.2,
    photoAlt: 'Analityczka finansowa przy monitorze',
  },
  {
    name: 'Imię i nazwisko',
    department: 'Obsługa klienta',
    bio: 'Odbiera telefony, porządkuje dokumenty i kieruje sprawy do właściwej osoby. Pierwszy kontakt, który odpowiada tego samego dnia.',
    photo: portraitFrontDesk,
    photoFocus: '15% 35%',
    photoZoom: 1.6,
    photoAlt: 'Pracownica biura w rozmowie z klientką',
  },
];

---
<BaseLayout
  title="O nas"
  description="Poznaj Biuro Rachunkowe Iwona Mazur. Księgowość, kadry i płace oraz doradztwo podatkowe dla firm każdej wielkości."
>
  <section class="flex min-h-screen flex-col px-[2vw] pt-40 max-lg:px-[4vw] max-lg:pt-28">
    <div class="-mx-[2vw] overflow-hidden pt-[0.5vw] pb-[3.6vw] -mt-[0.5vw] -mb-[1.6vw] max-lg:-mx-[4vw] max-lg:pt-[0.6vw] max-lg:pb-[4.2vw] max-lg:-mt-[0.6vw] max-lg:mb-[4.8vw]" aria-hidden="true">
      <div
        class="marquee-track marquee-track--hero flex w-max items-center gap-[clamp(1rem,3vw,4rem)]"
      >
        {
          Array.from({ length: MARQUEE_REPEATS * 2 }).map(() => (
            <>
              <span class="text-trim shrink-0 font-display text-[18vw] font-medium uppercase leading-[0.85] text-ink max-lg:text-[21vw]">
                O nas
              </span>
              <span
                class="shrink-0 rounded-full bg-ink"
                style={`width:${DASH_LENGTH};height:${DASH_THICKNESS}`}
              ></span>
            </>
          ))
        }
      </div>
    </div>

    <h1 class="sr-only">O nas</h1>

    <div
      class="relative mt-auto h-[80vh] shrink-0 overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)] max-lg:h-auto max-lg:flex-1"
      data-image-reveal
    >
      <Image
        src={officeTeam}
        alt="Dwie księgowe przy wspólnym stanowisku pracy w biurze"
        class="parallax-img"
        data-parallax
        widths={[768, 1280, 1600]}
        sizes="(width < 64rem) 300vw, 95vw"
        loading="eager"
      />
      <div class="reveal-panel absolute inset-0 z-10"></div>
    </div>
  </section>

  <section class="mt-[4vw] px-[2vw] max-lg:mt-[8vw] max-lg:px-[4vw]">
    <p
      class="ml-auto w-[75vw] indent-[14%] font-sans text-[clamp(1.5rem,2.6vw,4.5rem)] font-medium leading-[1.12] tracking-[-0.02em] text-graphite max-lg:w-full max-lg:indent-0 max-lg:text-[clamp(1.15rem,5.4vw,2.1rem)] max-lg:leading-[1.3] max-lg:tracking-normal"
      data-words-scrub
      data-from="0.3"
      data-to="1"
      data-start="top 92%"
      data-end="bottom 68%"
    >
      Księgowość to nie tylko terminy i deklaracje. To spokój, z jakim
      prowadzisz firmę, kiedy wiesz, że ktoś pilnuje Twoich liczb tak samo
      uważnie jak Ty.
    </p>

    <div class="ml-[20vw] mt-[6vw] flex gap-[5vw] max-lg:ml-0 max-lg:mt-[16vw] max-lg:flex-col max-lg:gap-[10vw]">
      <p
        class="flex-1 font-sans text-[clamp(0.9rem,1.05vw,1.3rem)] font-medium leading-[1.4] text-graphite max-lg:text-[clamp(0.95rem,4vw,1.5rem)] max-lg:leading-[1.35]"
        data-words-scrub
        data-from="0.2"
        data-to="1"
        data-start="top 90%"
        data-end="bottom 68%"
      >
        Biuro Rachunkowe Iwona Mazur prowadzi księgi firm z Dębicy i okolic
        od ponad dwudziestu lat. Zaczynaliśmy od kilku lokalnych działalności,
        którym wystarczała jedna księgowa odbierająca telefon. Dziś
        obsługujemy ponad osiemdziesiąt firm: jednoosobowe działalności,
        spółki handlowe i zakłady produkcyjne. Zespół urósł do jedenastu osób,
        a zasada została ta sama. Każdy klient ma swojego księgowego, który
        zna jego firmę, jej historię i wie, o co zapytać, zanim pojawi się
        problem.
      </p>

      <p
        class="flex-1 font-sans text-[clamp(0.9rem,1.05vw,1.3rem)] font-medium leading-[1.4] text-graphite max-lg:text-[clamp(0.95rem,4vw,1.5rem)] max-lg:leading-[1.35]"
        data-words-scrub
        data-from="0.2"
        data-to="1"
        data-start="top 90%"
        data-end="bottom 68%"
      >
        Prowadzimy pełną księgowość, księgi przychodów i rozchodów, kadry
        i płace oraz doradztwo podatkowe. Rozliczamy VAT krajowy i transakcje
        zagraniczne, przygotowujemy sprawozdania finansowe, reprezentujemy
        klientów przed urzędem skarbowym i ZUS. Dokumenty przyjmujemy tak, jak
        Ci wygodnie: w teczce, mailem albo przez KSeF. Na pytania odpowiadamy
        tego samego dnia, bo terminy w księgowości rzadko czekają, a dobra
        decyzja podatkowa prawie zawsze zapada przed transakcją, nie po niej.
      </p>
    </div>
  </section>

  <section class="relative mt-[12vw] h-[520vh] max-lg:hidden" data-horizontal>
    <h2
      class="px-[2vw] font-display text-[clamp(2rem,4.5vw,5.5rem)] font-medium uppercase leading-[1.05] text-graphite"
      data-reveal-lines="once"
    >
      <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">Nasi zaufani</span></span>
      <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">specjaliści</span></span>
    </h2>

    <div class="sticky top-0 flex h-screen flex-col justify-center overflow-hidden">
      <div
        class="flex w-max items-start gap-[1.5vw] pl-[52vw] pr-[2vw] will-change-transform"
        data-horizontal-track
        data-rise
      >
        {
          specialists.map(({ name, department, bio, photo, photoFocus, photoZoom, photoAlt }) => (
            <article
              class="flex aspect-square w-[clamp(18rem,27vw,33rem)] shrink-0 flex-col justify-between bg-graphite p-[clamp(1.5rem,2.2vw,3rem)]"
              data-rise-item
            >
              <div class="flex items-center gap-[clamp(1rem,1.4vw,2rem)]">
                <div class="aspect-square w-[clamp(4rem,6.5vw,8.5rem)] shrink-0 overflow-hidden rounded-full bg-placeholder">
                  <Image
                    src={photo}
                    alt={photoAlt}
                    class="h-full w-full object-cover"
                    style={`object-position: ${photoFocus}; transform-origin: ${photoFocus}; transform: scale(${photoZoom})`}
                    widths={[220, 440, 700]}
                    sizes="19vw"
                  />
                </div>

                <div class="min-w-0">
                  <p class="font-sans text-[clamp(1.05rem,1.4vw,1.7rem)] font-medium uppercase leading-[1.15] text-canvas">
                    {name}
                  </p>
                  <p class="mt-[clamp(0.2rem,0.35vw,0.5rem)] font-sans text-[clamp(0.85rem,1.1vw,1.3rem)] font-normal leading-[1.2] text-canvas/60">
                    {department}
                  </p>
                </div>
              </div>

              <p class="mt-[clamp(1.5rem,2vw,3rem)] font-sans text-[clamp(1rem,1.25vw,1.5rem)] font-normal leading-[1.35] text-canvas/85">
                {bio}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <SpecialistsSlider specialists={specialists} />

  <section class="relative mt-[12vw] h-[320vh] max-lg:mt-[20vw] max-lg:h-[240vh]" data-headline-pin data-stagger="0.15" data-hold="1">
    <div class="sticky top-0 h-screen overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center px-[2vw] max-lg:px-[4vw]"
        data-headline-group
      >
        <h2 class="text-center font-display text-[clamp(3rem,8vw,10rem)] font-medium uppercase leading-[1] text-graphite">
          <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">Przekonany?</span></span>
        </h2>
      </div>

      <div
        class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center px-[2vw] max-lg:px-[4vw]"
        data-headline-group
        data-stays
      >
        <h2 class="text-center font-display text-[clamp(2rem,4.5vw,5.5rem)] font-medium uppercase leading-[1.05] text-graphite max-lg:text-[clamp(1.4rem,7vw,2.75rem)]">
          <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">Umów się na darmową</span></span>
          <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">konsultację online</span></span>
        </h2>

        <div class="pointer-events-auto flex flex-col items-center" data-headline-extra>
          <p
            class="mt-[2vw] max-w-[42vw] text-center font-sans text-[clamp(0.95rem,1.1vw,1.25rem)] font-medium leading-[1.35] text-graphite max-lg:mt-[3vh] max-lg:max-w-none"
            data-extra-words
          >
            Trzydzieści minut rozmowy bez zobowiązań. Sprawdzimy, jak wygląda
            dziś Twoja księgowość i powiemy wprost, co da się w niej uprościć.
          </p>

          <span class="mt-[clamp(1rem,1.4vw,2rem)] flex overflow-hidden max-lg:mt-[3vh]">
            <a
              href="#"
              class="extra-line group relative z-10 inline-flex w-fit cursor-pointer items-center gap-[clamp(1rem,1.4vw,2rem)] overflow-hidden whitespace-nowrap rounded-full border-2 border-transparent bg-ink py-[clamp(0.75rem,0.9vw,1.15rem)] pl-[clamp(1.5rem,2.2vw,3rem)] pr-[clamp(0.75rem,1.1vw,1.5rem)] text-canvas transition-colors duration-700 hover:border-ink max-lg:gap-[4vw] max-lg:whitespace-normal max-lg:py-[3vw] max-lg:pl-[5vw] max-lg:pr-[3vw]"
              aria-haspopup="dialog"
              data-open-form
            >
              <span class="relative z-10 font-display text-[clamp(1rem,1.15vw,1.375rem)] font-normal uppercase transition-all duration-[400ms] group-hover:translate-x-[1.2vw] group-hover:text-ink max-lg:text-[0.85rem]">Umów się na konsultację</span>
              <span class="relative z-0 flex h-[clamp(1.75rem,2vw,2.75rem)] w-[clamp(1.75rem,2vw,2.75rem)] shrink-0 rounded-full bg-canvas transition-transform duration-700 ease-out group-hover:duration-[1600ms] group-hover:scale-[55]"></span>
            </a>
          </span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
